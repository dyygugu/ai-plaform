AIDP_MONITOR_ENV=dev
AIDP_MONITOR_VERSION=0.1.0-p0
AIDP_API_PREFIX=/api/v1
AIDP_DATABASE_URL=postgresql+psycopg://aidp:aidp_dev_password@postgres:5432/aidp_monitor
AIDP_REDIS_URL=redis://redis:6379/0
AIDP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIDP_CORS_ORIGIN_REGEX=^(https:\/\/([^/]+\.)?aidp\.juejin\.cn|chrome-extension:\/\/[a-p0-9]+|http:\/\/localhost(?::\d+)?|http:\/\/127\.0\.0\.1(?::\d+)?)$
AIDP_TASK_SOURCE_ACCOUNT_USER_ID=
AIDP_PUBLIC_BASE_URL=http://localhost:8787
AIDP_BACKUP_LOCAL_RETENTION_DAYS=7
AIDP_BACKUP_EXTERNAL_RETENTION_DAYS=30
AIDP_BACKUP_CLEANUP_TIME=03:30
AIDP_BACKUP_LOCAL_ROOT=./data/backups/local
AIDP_BACKUP_EXTERNAL_ROOT=/home/admin/aidp监控平台备份
AIDP_TASK_SAMPLE_ROOT=./data/redacted-samples
AIDP_AUTO_CREATE_TABLES=true
AIDP_LEGACY_ACCOUNTS_PATH=../aidp-monitor/config/accounts.docker-local.json
AIDP_INCIDENT_AI_BASE_URL=
AIDP_INCIDENT_AI_API_KEY=
AIDP_INCIDENT_AI_MODEL=gpt-4.1-mini
AIDP_INCIDENT_AI_TIMEOUT_SECONDS=30
# 双 AI 页面配置会写入该 JSON：system_ai 负责运维/系统处理，task_ai 只在做题草稿调用。
AIDP_AI_RUNTIME_CONFIG_PATH=./data/ai-runtime-config.json
AIDP_NOTIFICATION_CONFIG_PATH=./config/notifications.json
AIDP_FEISHU_WEBHOOK_URL=
AIDP_FEISHU_SECRET=
AIDP_NOTIFY_ENABLED=false
AIDP_NOTIFY_MIN_LEVEL=warn
AIDP_NOTIFY_EVENTS=backend.error,backend.unhandled_exception,audit.error,worker.error,alert.evaluation.failed,alert.evaluation.warning
AIDP_NOTIFY_DRY_RUN=false
AIDP_NOTIFY_COOLDOWN_SECONDS=300
